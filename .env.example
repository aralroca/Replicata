# --- Coordinator (crates/coordinator) ---
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
# Circle devnet USDC (default). On localnet scripts/localnet.sh writes its own mint.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
FACILITATOR_URL=https://x402.org/facilitator   # fallback: https://facilitator.payai.network
DATABASE_URL=postgres://replicata:replicata@127.0.0.1:54329/replicata
# Keypair (JSON file path, JSON array or base58) that pays crank fees; also the default treasury.
CRANK_KEYPAIR=~/.config/solana/replicata/crank.json
# TREASURY=<pubkey that receives x402 publish fees>
PUBLISH_FEE=100000
BIND=0.0.0.0:8787
PUBLIC_URL=http://localhost:8787
POLL_MS=1500

# --- Web (apps/web) ---
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_COORDINATOR_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Worker CLI ---
REPLICATA_COORDINATOR=http://localhost:8787
# REPLICATA_HOME=~/.replicata
